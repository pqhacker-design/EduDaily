rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Educational App Collections
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isValidId(classId);
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isValidId(quizId);
    }

    match /attempts/{attemptId} {
      allow read: if true;
      allow write: if isValidId(attemptId);
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId);
    }

    // Health / connection test doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
